[package]
name = "dungeon-scion-runtime-cluster"
version = "0.1.0"
edition = "2024"
rust-version = "1.98"
publish = false

# Standalone workspace: never add this helper to, or patch, upstream.
[workspace]
resolver = "3"

[dependencies]
scion-conformance = { path = "__SCION_UPSTREAM__/crates/scion-conformance" }
scion-proto = { path = "__SCION_UPSTREAM__/crates/scion-proto" }
scion-refmodel = { path = "__SCION_UPSTREAM__/crates/scion-refmodel" }
scion-testkit = { path = "__SCION_UPSTREAM__/crates/scion-testkit" }
# Exact versions/features from the pinned upstream workspace manifest.
anyhow = "=1.0.104"
clap = { version = "=4.6.7", features = ["derive", "env"] }
rustix = { version = "=1.1.5", features = ["process"] }
serde = { version = "=1.0.229", features = ["derive"] }
serde_json = "=1.0.154"
tempfile = "=3.27.0"
tokio = { version = "=1.53.3", features = ["full"] }

# Keep dependency codegen aligned with the existing upstream dev build.
[profile.dev.package."*"]
opt-level = 2
