schema_version:
    1
id:
    scoping.cross_scope_dependency
object_id:
    scoping.cross_scope_dependency
kind:
    component
responsibility:
    require cross scope dependencies to be declared and attributable to source and target scopes
level:
    L2
git_scope:
    main
isolation:
    BOUNDED
storage_state:
    LIVE
