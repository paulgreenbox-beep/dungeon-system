schema_version:
    1
id:
    scoping.level_identity
object_id:
    scoping.level_identity
kind:
    component
responsibility:
    keep LevelId and ObjectId independent from repository location and pathname
level:
    L0
git_scope:
    main
isolation:
    BOUNDED
storage_state:
    LIVE
retention:
    PERMANENT
flags:
    - PINNED
inputs:
    level id
    object id
    physical path
outputs:
    stable identity across relocation
    migration invariant
depends_on:
    scoping.git_scope
effects:
    relocation safety
    no identity from pathname
state:
    SKLT
