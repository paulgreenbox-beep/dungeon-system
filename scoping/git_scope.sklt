schema_version:
    1
id:
    scoping.git_scope
object_id:
    scoping.git_scope
kind:
    component
responsibility:
    declare a VersionScope history boundary with legacy GitScope compatibility without changing level or object identity
level:
    L0
git_scope:
    main
isolation:
    BOUNDED
storage_state:
    LIVE
retention:
    PERMANENT
flags:
    - PINNED
inputs:
    declared scope id
    scope mode MONOREPO REPOSITORY or EXTERNAL
    repository path
    default branch
    optional explicit VersionScope backend GIT or SCION
    local endpoint profile name without credentials
outputs:
    validated git scope registry
    known scope ids
    namespaced revision observations independent of Dungeon CAS
depends_on:
effects:
    history boundary separated from logical identity
    legacy projects default to main MONOREPO
    Scion is opt-in and unavailable state never falls back to Git
source:
    path: tools/project_structure/v03_manifest.py
    path: tools/project_structure/vcs_backends.py
    path: tools/project_structure/vcs_service.py
state:
    SKLT
